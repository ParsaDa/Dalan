  "libraries": [],
  "components": [
    {
      "name": "Bar",
      "group": "Data",
      "summary": "A gradient progress bar for CPU, memory, disk and quota."
    },
    {
      "name": "Button",
      "group": "Controls",
      "summary": "Primary, secondary (glass), ghost, danger and icon buttons."
    },
    {
      "name": "EmptyState",
      "group": "Surfaces",
      "summary": "An illustration, one line of title, one or two short sentences, and one action."
    },
    {
      "name": "GlassTile",
      "group": "Surfaces",
      "summary": "The base surface of every page: translucent fill, blurred backdrop, a hairline border and an 18 px radius, with an optional 2 px accent edge along the top."
    },
    {
      "name": "Header",
      "group": "Navigation",
      "summary": "Big greeting, one live status line, then search, Simple/Advanced, Effects, theme, notifications and the account."
    },
    {
      "name": "Modal",
      "group": "Surfaces",
      "summary": "Dialogs for create, edit and confirm."
    },
    {
      "name": "NodeTab",
      "group": "Navigation",
      "summary": "A pill per directly connected node under the header; picking one switches the whole panel into that node."
    },
    {
      "name": "Rail",
      "group": "Navigation",
      "summary": "The left navigation: grouped sections, a glowing active item, collapsible to an icon rail; becomes a bottom bar on phones."
    },
    {
      "name": "Sparkline",
      "group": "Data",
      "summary": "A small trend line inside a tile: 2.25 px stroke, round caps and joins, area fading from 28% accent to nothing, a dot at the latest point."
    },
    {
      "name": "StatusPill",
      "group": "Status",
      "summary": "A rounded label for a state: icon plus word, tinted by status."
    },
    {
      "name": "Table",
      "group": "Data",
      "summary": "Lists of clients, inbounds, hosts, logs: a dense glass tile holding a table, with filter chips above."
    },
    {
      "name": "Toggle",
      "group": "Controls",
      "summary": "An on/off switch for things that run: Xray, tunnels, inbounds, engines."
    }
  ],
